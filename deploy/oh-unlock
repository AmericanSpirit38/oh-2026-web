#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cp /etc/nginx/sites-available/oh-live /etc/nginx/sites-available/default
if nginx -t 2>/dev/null; then
  systemctl reload nginx
  echo "LIVE - site is public at /"
else
  echo "nginx config test FAILED - not reloaded" >&2
  nginx -t
  exit 1
fi
